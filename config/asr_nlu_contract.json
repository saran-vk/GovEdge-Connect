{
  "asr_output": {
    "type": "object",
    "required": ["transcript", "detected_language", "confidence_score", "timestamp"],
    "properties": {
      "transcript": { "type": "string", "description": "Raw ASR text output" },
      "detected_language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$", "description": "BCP-47 tag, e.g. ta-IN" },
      "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
      "timestamp": { "type": "string", "format": "date-time", "description": "ISO-8601 UTC" }
    }
  },
  "nlu_query": {
    "type": "object",
    "required": ["intents", "entities", "query", "language"],
    "properties": {
      "query": { "type": "string", "description": "Normalized query text sent downstream" },
      "language": { "type": "string" },
      "intents": { "type": "array", "items": { "type": "string" } },
      "entities": { "type": "object" },
      "sources": { "type": "array", "items": { "type": "string" } }
    }
  }
}
