# ==============================================================================
# GovConnect Edge - Environment Configuration
# ==============================================================================

# Runtime Mode: mock | hybrid | local
# - mock: Canned transcripts, rules NLU, mock TTS (fast dev / offline testing)
# - hybrid: Local ASR/NMT/NLU + hosted cloud LLM + Bulbul/remote TTS (standard demo)
# - local: Quantized ASR/NLU + cache & extractive fallback only (Pi-profile emulated)
RUNTIME_MODE=mock

# Translation ablation flag (default true)
USE_NMT=true

# NLU confidence threshold to trigger cached answers
CONF_THRESHOLD=0.80

# Gateway Server
HOST=0.0.0.0
PORT=8000

# Redis Cache (Scheme x Intent x Language pre-synthesized responses)
REDIS_URL=redis://localhost:6379/0

# ChromaDB Vector Store
CHROMA_PERSIST_DIR=./data/chroma

# LLM Configuration (Hybrid mode)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=sarvam-2b
LLM_ENDPOINT=

# Speech APIs & TTS (Hybrid mode)
# TTS_PROVIDER: bulbul | indictts | mock
TTS_PROVIDER=bulbul
SARVAM_API_KEY=
BULBUL_API_KEY=
INDICTTS_API_URL=https://models.ai4bharat.org/v2/tts
INDICTTS_API_KEY=

# Logging
LOG_LEVEL=INFO
